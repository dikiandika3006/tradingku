# Untuk hosting yang document root-nya = root repo (mis. Hostinger public_html).
# Semua request diteruskan ke folder public/, jadi .env, storage, vendor, dll.
# tidak pernah bisa diakses langsung dari web.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Cadangan bila mod_rewrite mati: tolak akses ke file sensitif.
# (Berlaku juga di dalam public/, jadi jangan masukkan ekstensi yang dipakai di sana, mis. .json.)
<FilesMatch "^\.env|\.(log|sh|sql|lock)$">
    Require all denied
</FilesMatch>
